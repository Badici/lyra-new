# Application
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth (generate a long random string)
BETTER_AUTH_SECRET=replace-with-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Admin seed (never commit real passwords)
SEED_ADMIN_EMAIL=raresbadici@gmail.com
SEED_ADMIN_PASSWORD=

# Email (Resend) — optional in development
RESEND_API_KEY=
MAIL_FROM=LyraBaits <no-reply@lyrabaits.ro>
ADMIN_NOTIFICATION_EMAIL=raresbadici@gmail.com

# Business / contact (non-secret; may move to DB settings later)
WHATSAPP_PHONE=40728241412
CONTACT_EMAIL=contact@lyrabaits.ro
ORDER_NUMBER_PREFIX=LYRA

# Safety: only allow destructive reset when explicitly set
ALLOW_DB_RESET=false

# Optional media uploads (Vercel Blob). Without it, admin uploads go to public/uploads/
BLOB_READ_WRITE_TOKEN=
